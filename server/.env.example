# Points at the docker-compose postgres service by default.
DATABASE_URL=postgres://decompute:decompute@localhost:5432/decompute

# Generate a real secret for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-secret-change-me

PORT=3000

# Production workload images must be immutable registry digests. Both the API
# and every provider agent must receive the same JSON mapping. Local development
# defaults to the operator-built decompute/image-gen:local image when unset.
# DECOMPUTE_WORKLOAD_IMAGES={"image-generation":"ghcr.io/your-org/image-gen@sha256:..."}

# Automatic matching is community-only and fair-share by design. It first
# stays within 35% of the cheapest eligible node, then favors owners with lower
# completed earnings over the last 7 days and a longer wait since assignment.
# There is intentionally no AWS/Google/Bedrock fallback setting.

# Must match the frontend's origin so the browser can call this API.
CORS_ORIGIN=http://localhost:5173

# Where Stripe Checkout redirects back to after a payment attempt.
CLIENT_URL=http://localhost:5173

# From your Stripe Dashboard, test mode: developers.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# From `stripe listen` locally (it prints a whsec_... secret), or from the
# Dashboard's webhook endpoint settings once deployed.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Fixed-price video (see docs/video-runbook.md) ───────────────────────────
# Off unless "true". Video also stays hidden until the planner key and at least
# one shot preset plus the reference preset are pinned below.
# VIDEO_ENABLED=true
# GEMINI_API_KEY=...
# A preset is enabled only by pinning BOTH its image digest and the 40-hex
# model revision baked into that image (the container refuses a mismatch).
# Every provider agent needs the same images in DECOMPUTE_WORKLOAD_IMAGES under
# video-reference / video-generation / video-generation-fast.
# VIDEO_REFERENCE_IMAGE=registry.example/video-reference@sha256:...
# VIDEO_REFERENCE_REVISION=462165984030d82259a11f4367a4eed129e94a7b
# VIDEO_SHOT_IMAGE=registry.example/video-gen@sha256:...
# VIDEO_SHOT_REVISION=b8fff7315c768468a5333511427288870b2e9635
# VIDEO_FAST_SHOT_IMAGE=registry.example/video-gen-fast@sha256:...
# VIDEO_FAST_SHOT_REVISION=3e187042a324f6f5fb68fd22110a78725253de8f
# Shared persistent directory for shots and finished videos. On Cloud Run,
# mount a Cloud Storage volume here; instance disks are private and ephemeral.
# VIDEO_STORAGE_DIR=/mnt/video
# Defaults to ffmpeg/ffprobe on PATH (the Dockerfile installs them).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
