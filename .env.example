# Backend API URL — only needed if you're running the Decompute backend.
# Without this the app runs in demo mode with realistic sample data.
#
# To use: copy this file to .env, uncomment the line below, then restart the
# dev server.

# VITE_API_BASE=http://localhost:3000

# Where the compiled seller helper binaries (see helper/) are hosted.
# Defaults to this repo's GitHub Releases "latest" alias if unset — only
# set this if you're hosting the binaries somewhere else instead.

# VITE_HELPER_BINARY_BASE_URL=https://github.com/Exoplanetarium/Decompute/releases/latest/download
